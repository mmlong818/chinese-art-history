  "one_line": "盛唐彩塑的代表窟，西壁龛内七尊塑像保存完整——中国塑像史上最常被引作「盛唐范式」的一组。",
  "verification": "memory",
  "updated": "2026-08-04",
  "sources": [
    {
      "ref": "dunhuang-academy",
      "note": "洞窟编号与内容"
    },
    {
      "ref": "zhongguo-meishu-jianshi",
      "note": "盛唐彩塑的风格定位"
    }
  ],
  "sections": {
    "overview": [
      {
        "t": "p",
        "text": "第 45 窟为覆斗顶殿堂窟，西壁开一龛，龛内塑一佛、二弟子、二菩萨、二天王共七尊，保存基本完整，是盛唐彩塑最常被引用的一组。"
      },
      {
        "t": "stmt",
        "state": "adopt",
        "text": "其价值在于「成组完整」：多数洞窟的塑像已残损或经后代重塑，第 45 窟七尊皆存且未大改，故成为判断盛唐塑像原貌的基准之一。",
        "src": "dunhuang-academy"
      }
    ],
    "history": [
      {
        "t": "tl",
        "rows": [
          {
            "when": "8 世纪",
            "text": "盛唐开凿并塑绘。"
          },
          {
            "when": "后代",
            "text": "未见大规模重塑，此为其可贵处。"
          }
        ]
      },
      {
        "t": "gap",
        "text": "确切开凿年份无题记可依，「盛唐」系按形制与画风推定"
      }
    ],
    "layout": [
      {
        "t": "kv",
        "rows": [
          [
            "窟形",
            "覆斗顶殿堂窟"
          ],
          [
            "西壁龛",
            "塑像七尊"
          ],
          [
            "塑像组合",
            "一佛、二弟子（迦叶、阿难）、二菩萨、二天王"
          ],
          [
            "南北壁",
            "经变壁画"
          ]
        ]
      }
    ],
    "donors": [
      {
        "t": "gap",
        "text": "本窟供养人题名不存或未辨识，出资者不可考"
      }
    ],
    "iconography": [
      {
        "t": "p",
        "text": "龛内七尊按等级对称配置，佛居中禅定，弟子拘谨，菩萨作 S 形侧倾，天王踏鬼作怒相——四种身体语言分列四等，是盛唐造像等级化最清楚的一例。"
      },
      {
        "t": "stmt",
        "state": "adopt",
        "text": "菩萨的侧倾与天王的动势，与初唐的端正并列相比是明显的松动。这一变化在塑像上比在壁画上更易观察，因为塑像是可绕行的三维体。"
      }
    ],
    "conservation": [
      {
        "t": "p",
        "text": "整体保存较好，局部彩绘褪色与起甲。"
      },
      {
        "t": "gap",
        "text": "历次保护干预的具体记录，本库未核实"
      }
    ],
    "archaeology": [
      {
        "t": "p",
        "text": "断代依形制与壁画风格，无纪年题记。"
      }
    ],
    "disputes": [
      {
        "t": "stmt",
        "state": "pend",
        "text": "开凿年代的具体区间（盛唐早段或中段），各家判断略异。"
      },
      {
        "t": "gap",
        "text": "塑像是否有后代小规模补彩，缺技术检测报告"
      }
    ]
  }
