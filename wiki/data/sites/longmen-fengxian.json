  "name": "奉先寺",
  "name_en": "Fengxian Temple",
  "parent": "longmen",
  "where": "龙门西山",
  "span": "约 672 – 675",
  "sort": 10,
  "keys": [
    "唐",
    "露天大龛",
    "卢舍那",
    "皇室营建"
  ],
  "one_line": "龙门规模最大的一处露天大龛，主尊卢舍那高逾十七米——唐代造像的体量与气度在此定型。",
  "verification": "memory",
  "updated": "2026-08-04",
  "sources": [
    {
      "ref": "zhongguo-meishu-jianshi",
      "note": "营建年代与形制"
    },
    {
      "ref": "met-timeline",
      "note": "唐代造像语境"
    }
  ],
  "sections": {
    "overview": [
      {
        "t": "p",
        "text": "奉先寺是龙门西山南段的一处露天大龛，不作洞窟而直接在崖面凿出巨龛，主尊卢舍那大佛居中，两侧依次为二弟子、二菩萨、二天王、二力士，共九尊。"
      },
      {
        "t": "stmt",
        "state": "adopt",
        "text": "其规制与体量在龙门无出其右，是唐代皇室介入石窟营建的代表工程。",
        "src": "zhongguo-meishu-jianshi"
      }
    ],
    "history": [
      {
        "t": "tl",
        "rows": [
          {
            "when": "约 672",
            "text": "依碑记记载开始营建。"
          },
          {
            "when": "约 675",
            "text": "完工。前后约三年余。"
          },
          {
            "when": "后代",
            "text": "龛前原有木构建筑，后毁；今为露天。"
          }
        ]
      },
      {
        "t": "stmt",
        "state": "pend",
        "text": "开凿与完工的确切月份、以及龛前木构的形制与毁弃年代，均缺充分记载。"
      }
    ],
    "layout": [
      {
        "t": "kv",
        "rows": [
          [
            "形制",
            "露天摩崖大龛，非洞窟"
          ],
          [
            "造像组合",
            "一佛、二弟子、二菩萨、二天王、二力士，共九尊"
          ],
          [
            "主尊",
            "卢舍那大佛"
          ],
          [
            "龛前原状",
            "原有木构覆盖，今已不存"
          ]
        ]
      }
    ],
    "donors": [
      {
        "t": "stmt",
        "state": "adopt",
        "text": "营建有皇室出资的记载。奉先寺是龙门赞助结构最清楚的一处，也是本库「供养与出资」这一维度最有内容可写的样本。"
      },
      {
        "t": "stmt",
        "state": "disp",
        "text": "武则天出资的具体数额见于流传记载，学界对其可靠性有异议——见母条目 [[site:longmen]] 的争议字段。"
      }
    ],
    "iconography": [
      {
        "t": "p",
        "text": "卢舍那为报身佛，其造像在唐代与皇权象征之间的关联，是学界长期讨论的题目。九尊的配置由中心向两侧等级递降，力士居最外，动势最强。"
      },
      {
        "t": "stmt",
        "state": "disp",
        "text": "卢舍那面相是否以武则天为模拟，流传极广而无直接证据。这类「以帝王为原型」的说法在中国佛教造像研究中反复出现，本库一律标为无据推测，不予采信。"
      }
    ],
    "conservation": [
      {
        "t": "p",
        "text": "露天暴露使风化与雨水冲刷成为主要威胁，历代有修补痕迹。"
      },
      {
        "t": "gap",
        "text": "历次修补的年代与范围，本库尚未核实到系统记录"
      }
    ],
    "archaeology": [
      {
        "t": "p",
        "text": "断代主要依据龛内碑记，是龙门少数有明确纪年支撑的大型工程之一。"
      }
    ],
    "disputes": [
      {
        "t": "stmt",
        "state": "disp",
        "text": "主尊面相是否以武则天为原型——流传广而无据，本库不采。"
      },
      {
        "t": "stmt",
        "state": "pend",
        "text": "龛前木构的形制与毁弃年代不明。"
      }
    ]
  }
}
